{
  "expo": {
    "name": "Baby Growth Timeline",
    "slug": "baby-growth-timeline",
    "version": "1.0.0",
    "scheme": "babygrowth",
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "app"
        }
      ],
      "expo-image-picker",
      "expo-document-picker"
    ],
    "ios": {
      "bundleIdentifier": "com.local.babygrowth"
    },
    "android": {
      "package": "com.local.babygrowth"
    }
  }
}
